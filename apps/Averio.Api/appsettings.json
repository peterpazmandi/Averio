{
  "Receipts": {
    "Enabled": false,
    "DailyUploadLimit": 20,
    "FreeMonthlyLimit": 10,
    "PaidMonthlyLimit": 100,
    "PaidHouseholds": {},
    "RetainPostedImages": false,
    "PostedImageRetentionDays": 365
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Averio.Application.Receipts": "Information",
      "Averio.Infrastructure.Receipts": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ConnectionStrings": {
    "AverioDatabase": ""
  },
  "Email": {
    "Provider": "Development",
    "FrontendBaseUrl": "http://localhost:5173",
    "LogoUrl": "https://averioapp.com/branding/averio-email-logo.png",
    "SenderEmail": "support@averioapp.com",
    "SenderName": "Averio",
    "BrevoApiKey": ""
  }
}
