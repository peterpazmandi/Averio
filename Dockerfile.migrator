# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
WORKDIR /src
COPY . .
RUN dotnet tool install --tool-path /tools dotnet-ef --version 10.0.11
RUN dotnet restore apps/Averio.Api/Averio.Api.csproj
# The design-time factory requires an explicit value; bundling does not connect.
ENV AVERIO_MIGRATION_CONNECTION_STRING="Host=localhost;Database=build;Username=build;Password=build"
RUN case "$TARGETARCH" in amd64) rid=linux-x64 ;; arm64) rid=linux-arm64 ;; *) exit 1 ;; esac \
    && mkdir -p /out \
    && /tools/dotnet-ef migrations bundle \
      --project src/Averio.Infrastructure \
      --startup-project apps/Averio.Api \
      --configuration Release --self-contained --target-runtime "$rid" \
      --output /out/efbundle
FROM mcr.microsoft.com/dotnet/runtime-deps:10.0
WORKDIR /app
COPY --from=build /out/efbundle /app/efbundle
ENTRYPOINT ["/app/efbundle"]
